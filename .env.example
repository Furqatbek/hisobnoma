# =================================================
# Hisobnoma Platform - Environment Configuration
# Copy this file to .env and fill in the values
# =================================================

# ==================== Application ====================
APP_VERSION=latest
SPRING_PROFILES_ACTIVE=prod

# ==================== Database ====================
DB_NAME=hisobnoma
DB_USERNAME=hisobnoma_user
DB_PASSWORD=your_secure_database_password_here
DB_POOL_SIZE=20
DB_MIN_IDLE=10

# ==================== Redis ====================
REDIS_PASSWORD=your_secure_redis_password_here

# ==================== JWT Security ====================
# Generate with: openssl rand -base64 64
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=86400000

# ==================== API Documentation ====================
SWAGGER_ENABLED=false

# ==================== Grafana ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
GRAFANA_ROOT_URL=http://your-domain.com:3000

# ==================== Alertmanager (Email) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_TO=alerts@your-domain.com

# ==================== Slack Alerts (Optional) ====================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==================== Backup Configuration ====================
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# ==================== SSL/TLS (Production) ====================
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ==================== External Services (Optional) ====================
# SENTRY_DSN=https://your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your_new_relic_key

# =================================================
# Application credentials read by application*.yml (${VAR}) at startup.
# The bundled DotenvEnvironmentPostProcessor loads this file when named `.env`;
# real OS environment variables override it, so production is unaffected.
# =================================================

# ==================== Application ====================
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HEADERS=true
# Distributed (Redis) rate limiting. Defaults false (in-memory, per-instance);
# the prod profile defaults it true so limits hold across pods. Needs Redis.
RATELIMIT_REDIS=false
# JWT access/refresh lifetimes in ms (application.yml reads these two names).
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ==================== Database / Redis hosts (prod profile) ====================
DB_HOST=localhost
DB_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== APNs push (admin mobile app) ====================
# Disabled until all values are set; while disabled, sends are a logged no-op.
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.hisobnoma.admin
# Paste the .p8 contents on ONE line with \n between lines (double-quoted), e.g.:
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APNS_PRIVATE_KEY=

# ==================== Online payment providers (shop) — disabled by default ====================
PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_ENABLED=false
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=
UZUM_ENABLED=false
UZUM_MERCHANT_ID=
UZUM_SECRET=

# ==================== SMS (OTP / alerts) ====================
SMS_ENABLED=false
SMS_BASE_URL=https://devsms.uz/api
SMS_API_TOKEN=
SMS_SENDER_ID=

# ==================== Telegram notifications ====================
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=hisobnoma_bot
